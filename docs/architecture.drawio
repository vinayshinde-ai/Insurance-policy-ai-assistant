        <mxCell id="c51" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Customer opens the app over HTTPS&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; CloudFront (with AWS WAF) forwards to the ALB&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; ALB routes to a healthy app instance&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Customer signs in with Amazon Cognito&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; App loads the customer's own policy from S3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="780" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c52" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp; App retrieves relevant policy passages from the Knowledge Base&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Claude Haiku 4.5 generates the answer with citations&lt;br&gt;&lt;b&gt;8&lt;/b&gt;&amp;nbsp; Bedrock Guardrails screen the question and the answer&lt;br&gt;&lt;b&gt;9&lt;/b&gt;&amp;nbsp; Each chat turn is saved to DynamoDB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="830" y="780" width="640" height="110" as="geometry" />
        </mxCell>
